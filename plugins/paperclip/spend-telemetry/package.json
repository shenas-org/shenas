{
  "name": "paperclip-plugin-spend-telemetry",
  "version": "0.1.0",
  "type": "module",
  "description": "Paperclip plugin: per-issue and per-run spend telemetry dashboards for shenas.",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "dev:ui": "paperclip-plugin-dev-server --root . --ui-dir dist/ui --port 4177",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "spend",
    "telemetry",
    "costs"
  ],
  "author": "shenas.ai",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "^2026.513.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "esbuild": "^0.27.3",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}